<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CuBlocky.Server</RootNamespace>
    <AssemblyName>CuBlocky.Server</AssemblyName>
    <Version>0.1.5</Version>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableDefaultContentItems>true</EnableDefaultContentItems>
  </PropertyGroup>

  <!-- Frontend (web/) builds into server/wwwroot via vite.config.ts outDir -->

  <!-- Exclude generated build output from compilation -->
  <ItemGroup>
    <Compile Remove="builds\**" />
    <Content Remove="builds\**" />
    <None Remove="builds\**" />
  </ItemGroup>

</Project>
